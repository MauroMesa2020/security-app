
# OWASP ZAP
ZAP_API_KEY=replace_with_your_own_random_api_key
ZAP_API_URL=http://zap:8080
ZAP_TIMEOUT=1800
ZAP_POLL_INTERVAL=2
ZAP_ACTIVE_SCAN=true

# PostgreSQL
POSTGRES_DB=security_analysis
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace_with_a_strong_password

# Database connection
DATABASE_URL=postgresql://admin:replace_with_a_strong_password@db:5432/security_analysis